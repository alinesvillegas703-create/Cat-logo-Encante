{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cat-logo-encante",
  "compatibility_date": "2026-09-06",
  "main": "./worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
